{
  "redirects": [
    {
      "source": "/auth",
      "destination": "https://app.matriculemaiscrm.com.br/auth",
      "permanent": false
    },
    {
      "source": "/auth/:path*",
      "destination": "https://app.matriculemaiscrm.com.br/auth/:path*",
      "permanent": false
    }
  ],
  "routes": [
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/matriculemaislogooficial.svg", "dest": "/matriculemaislogooficial.svg" },
    { "src": "/matricule%2B%20dark.png", "dest": "/matricule%2B%20dark.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
